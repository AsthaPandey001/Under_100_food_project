# ==============================================================================
# BITE100 / UNDER100 FOOD DISCOVERY — PRODUCTION ENVIRONMENT CONFIGURATION
# Copy this file to `.env` in production and supply strong, real secrets.
# NEVER commit real credentials or production `.env` files to version control.
# ==============================================================================

# Application Environment Mode (local | dev | staging | prod | test)
PAGODA_APP_ENVIRONMENT=prod

# Application Base URL (used for password reset and email verification links; no trailing slash)
# Used to prevent Host-header poisoning:
APP_BASE_URL=http://localhost:8000
PAGODA_HTTP_DOMAIN=http://localhost:8000
PAGODA_HTTP_HOSTNAME=0.0.0.0
PAGODA_HTTP_PORT=8000

# Critical Secret: Session & Cookie Encryption Key (min 32 characters recommended)
# Generate a strong key: `openssl rand -base64 32`
PAGODA_APP_ENCRYPTIONKEY=YOUR_SECURE_RANDOM_SESSION_ENCRYPTION_KEY_MIN_32_CHARS

# Database Configuration (PostgreSQL 15+)
PAGODA_DATABASE_DBMODE=standalone
PAGODA_DATABASE_HOSTNAME=localhost
PAGODA_DATABASE_PORT=5432
PAGODA_DATABASE_USER=admin
PAGODA_DATABASE_PASSWORD=YOUR_STRONG_DATABASE_PASSWORD
PAGODA_DATABASE_DATABASENAMEPROD=goship_db
PAGODA_DATABASE_SSLMODE=disable

# Redis Cache & Rate Limiting Configuration (port 6379)
PAGODA_CACHE_HOSTNAME=localhost
PAGODA_CACHE_PORT=6379
PAGODA_CACHE_PASSWORD=YOUR_REDIS_PASSWORD_OR_EMPTY
PAGODA_CACHE_DATABASE=0

# ==============================================================================
# ZERO-COST-FIRST AUTHENTICATION & NOTIFICATION CHANNELS
# ==============================================================================

# 1. Transactional Email Provider (Resend API - Free Tier: 3,000 emails/month free)
# Sign up at https://resend.com to obtain a free API key.
# In local development, if left empty, the system automatically falls back to
# a mock mailer that logs verification & reset emails to terminal (₹0 cost).
PAGODA_MAIL_FROMADDRESS=auth@foodunder100.in
PAGODA_MAIL_RESENDAPIKEY=
RESEND_API_KEY=

# 2. SMS / Phone OTP Delivery Provider
# In local development / testing (PAGODA_APP_ENVIRONMENT != prod):
# Defaults automatically to SimulatedProvider:
#   - Generated 6-digit OTPs are securely hashed in PostgreSQL.
#   - Plaintext OTP is printed to the server terminal log with [DEV SIMULATED OTP] tag.
#   - Zero SMS cost, zero gateway registration required.
# In production (PAGODA_APP_ENVIRONMENT = prod):
#   - SimulatedProvider is strictly BLOCKED by security guards.
#   - Real telecom delivery is required via one of the following gateways:
#
# Option A: Fast2SMS (Indian Gateway with DLT / Quick OTP support)
FAST2SMS_API_KEY=
#
# Option B: Twilio Gateway
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# Local Development / Mailpit SMTP (Used when PAGODA_APP_ENVIRONMENT != prod)
PAGODA_MAIL_HOSTNAME=localhost
PAGODA_MAIL_SMTPPORT=1025
PAGODA_MAIL_HTTPPORT=8025


# Optional Third-Party Services
# Sentry Error Reporting DSN
PAGODA_APP_SENTRYDSN=

# Stripe Payments (if enabled)
PAGODA_APP_PUBLICSTRIPEKEY=pk_test_placeholder
PAGODA_APP_PRIVATESTRIPEKEY=sk_test_placeholder
PAGODA_APP_STRIPEWEBHOOKSECRET=whsec_placeholder
